# -----------------------------------------------------------------------------
# TripGenius AI - Environment Configuration Template
# Copy this file to .env.local for local development.
# Do not commit your actual secrets (e.g. .env or .env.local) to version control!
# -----------------------------------------------------------------------------

# Supabase Credentials (Required)
# Found in Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Provider Abstraction (Required)
# Supported values: 'gemini' (default), 'openai', 'qwen'
AI_PROVIDER=gemini

# Set to 'mock' to use DB-seeded mock data, or 'production' for live external APIs
DATA_SOURCE=mock

# Google Gemini Configuration (Required if AI_PROVIDER=gemini)
# Get key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
GEMINI_PRO_MODEL=gemini-2.5-pro-preview-05-06
GEMINI_FLASH_MODEL=gemini-2.5-flash-preview-05-20
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI Configuration (Required if AI_PROVIDER=openai)
# Get key from OpenAI Developer Platform: https://platform.openai.com/
OPENAI_API_KEY=sk-proj-...
OPENAI_PRO_MODEL=gpt-4o
OPENAI_FLASH_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qwen Configuration (Required if AI_PROVIDER=qwen)
# Get key from Alibaba Cloud DashScope: https://dashscope.console.aliyun.com/
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-flash
QWEN_FLASH_MODEL=qwen-turbo
QWEN_EMBEDDING_MODEL=text-embedding-v3

# Google Places API (Server-Side, Required)
# Enables POI details, categories, and caching.
# Get key from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_PLACES_API_KEY=AIzaSy...

# Google Maps JS SDK Key (Client-Side, Required)
# Restrict this key in Google Cloud Console to only allow loading from your domains!
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy...

# Amadeus Self-Service API (Server-Side, Required)
# Enables real-time hotel search and recommendations.
# Register and get credentials from: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your-client-id
AMADEUS_CLIENT_SECRET=your-client-secret

# Application Host URL (Required in production for redirects/auth flow)
NEXT_PUBLIC_APP_URL=http://localhost:3000
